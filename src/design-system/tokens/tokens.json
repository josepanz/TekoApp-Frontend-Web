        "$value": "{color.brand.neutral.950}"
      },
      "destructive": { "$type": "color", "$value": "{color.semantic.danger}" },
      "success": { "$type": "color", "$value": "{color.semantic.success}" },
      "warning": { "$type": "color", "$value": "{color.semantic.warning}" },
      "info": { "$type": "color", "$value": "{color.semantic.info}" },
      "border": { "$type": "color", "$value": "{color.brand.neutral.800}" },
      "input": { "$type": "color", "$value": "{color.brand.neutral.800}" },
      "ring": { "$type": "color", "$value": "{color.brand.primary.300}" },
      "sidebar": { "$type": "color", "$value": "{color.brand.neutral.950}" },
      "sidebar-foreground": {
        "$type": "color",
