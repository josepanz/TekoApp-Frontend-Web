        "$value": "{color.brand.neutral.100}"
      },
      "sidebar-accent-foreground": {
        "$type": "color",
        "$value": "{color.brand.neutral.900}"
      },
      "sidebar-border": {
        "$type": "color",
        "$value": "{color.brand.neutral.200}"
      },
      "sidebar-ring": {
        "$type": "color",
        "$value": "{color.brand.primary.600}"
      },
      "chart-1": { "$type": "color", "$value": "{color.brand.primary.400}" },
      "chart-2": { "$type": "color", "$value": "{color.brand.accent.500}" },
      "chart-3": { "$type": "color", "$value": "{color.semantic.info}" },
      "chart-4": { "$type": "color", "$value": "{color.semantic.success}" },
      "chart-5": { "$type": "color", "$value": "{color.semantic.warning}" }
    },
    "dark": {
      "background": { "$type": "color", "$value": "{color.brand.neutral.900}" },
      "foreground": { "$type": "color", "$value": "{color.brand.neutral.50}" },
      "card": { "$type": "color", "$value": "{color.brand.neutral.850}" },
