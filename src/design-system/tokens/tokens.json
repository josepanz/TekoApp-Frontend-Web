{
  "$description": "TekoApp design tokens — W3C Design Tokens format. Fuente única de verdad de marca: cambiar acá cambia toda la UI (web hoy, Flutter cuando arranque). No hardcodear estos valores en componentes — ver .claude/rules/design-system.md",
  "color": {
    "brand": {
      "primary": {
        "50": { "$type": "color", "$value": "oklch(0.97 0.02 147)" },
        "100": { "$type": "color", "$value": "oklch(0.93 0.05 147)" },
        "200": { "$type": "color", "$value": "oklch(0.86 0.09 147)" },
        "300": { "$type": "color", "$value": "oklch(0.78 0.13 147)" },
        "400": { "$type": "color", "$value": "oklch(0.70 0.16 147)" },
        "500": {
          "$type": "color",
          "$value": "oklch(0.640 0.175 146.7)",
          "$description": "Primario de marca — verde TekoApp (#28A745, manual de marca). Ancla exacta calculada de hex→oklch."
        },
        "600": {
          "$type": "color",
          "$value": "oklch(0.52 0.165 147)",
          "$description": "Shade accesible del verde de marca — el 500 exacto (L .64) da solo 3.1:1 de contraste con texto blanco (falla AA texto normal). Este 600 (L .52) da ~5:1. Usado como --primary/--ring en el tema claro; ver .claude/rules/accessibility.md."
        },
        "700": { "$type": "color", "$value": "oklch(0.46 0.145 147)" },
        "800": { "$type": "color", "$value": "oklch(0.38 0.12 147)" },
        "900": { "$type": "color", "$value": "oklch(0.30 0.095 147)" }
      },
      "accent": {
        "50": { "$type": "color", "$value": "oklch(0.97 0.02 193)" },
        "100": { "$type": "color", "$value": "oklch(0.93 0.04 193)" },
        "200": { "$type": "color", "$value": "oklch(0.87 0.07 193)" },
        "300": { "$type": "color", "$value": "oklch(0.81 0.095 193)" },
        "400": { "$type": "color", "$value": "oklch(0.77 0.11 193)" },
        "500": {
          "$type": "color",
          "$value": "oklch(0.726 0.121 192.8)",
          "$description": "Acento de marca — teal TekoApp (#17BEBB, manual de marca). Ancla exacta calculada de hex→oklch."
        },
        "600": { "$type": "color", "$value": "oklch(0.62 0.115 193)" },
        "700": { "$type": "color", "$value": "oklch(0.52 0.10 193)" },
        "800": { "$type": "color", "$value": "oklch(0.43 0.085 193)" },
        "900": { "$type": "color", "$value": "oklch(0.35 0.07 193)" }
      },
      "neutral": {
        "0": { "$type": "color", "$value": "oklch(1 0 0)" },
        "50": {
          "$type": "color",
          "$value": "oklch(0.975 0.005 258)",
          "$description": "Gris claro de marca (#F5F7FA, manual de marca)"
        },
        "100": { "$type": "color", "$value": "oklch(0.955 0.006 256)" },
        "200": { "$type": "color", "$value": "oklch(0.89 0.008 254)" },
        "300": { "$type": "color", "$value": "oklch(0.79 0.010 252)" },
        "400": { "$type": "color", "$value": "oklch(0.63 0.013 251)" },
        "500": { "$type": "color", "$value": "oklch(0.49 0.016 251)" },
        "600": { "$type": "color", "$value": "oklch(0.39 0.020 251)" },
        "700": { "$type": "color", "$value": "oklch(0.29 0.026 251)" },
        "800": { "$type": "color", "$value": "oklch(0.26 0.030 251)" },
        "850": {
          "$type": "color",
          "$value": "oklch(0.23 0.033 251)",
          "$description": "Superficie elevada en dark mode (cards)"
        },
        "900": {
          "$type": "color",
          "$value": "oklch(0.218 0.036 251.3)",
          "$description": "Fondo base de dark mode — navy TekoApp exacto (#0D1B2A, manual de marca), nunca negro puro"
        },
        "950": { "$type": "color", "$value": "oklch(0.15 0.025 250)" }
      }
    },
    "semantic": {
      "success": {
        "$type": "color",
        "$value": "oklch(0.64 0.15 147)",
        "$description": "Coincide casi exacto con el hue del verde de marca (147°) — ya estaba alineado antes del rebrand, solo se ajustó el hue en 1° para consistencia total con primary.500"
      },
      "warning": {
        "$type": "color",
        "$value": "oklch(0.54 0.15 85)",
        "$description": "Dorado de marca (#FFC107, manual de marca), con lightness bajada a 0.54 para que sirva de color de TEXTO sobre fondo claro (~5:1) — el valor crudo del hex (L .844) da 0:1 legible y L .64 (primer intento de este rebrand) seguía fallando AA en 3.39:1, medido con la fórmula real de contraste WCAG. Ver .claude/rules/accessibility.md"
      },
      "danger": { "$type": "color", "$value": "oklch(0.58 0.22 27)" },
      "info": {
        "$type": "color",
        "$value": "oklch(0.60 0.14 235)",
        "$description": "Azul convencional (no es un color del manual de marca) — se mantiene por legibilidad universal del significado \"informativo\"; el manual no define un color para este uso semántico."
      }
    }
  },
  "typography": {
    "fontFamily": {
      "sans": {
        "$type": "fontFamily",
        "$value": ["Poppins", "system-ui", "sans-serif"],
        "$description": "Tipografía única de marca (manual de marca) — Bold/SemiBold/Regular/Light. Antes: Geist."
      },
      "heading": {
        "$type": "fontFamily",
        "$value": ["Poppins", "system-ui", "sans-serif"],
        "$description": "El manual de marca no define una tipografía de heading separada — usa Poppins para todo, diferenciado solo por peso (Bold/SemiBold). Antes: Sora."
      },
      "mono": {
        "$type": "fontFamily",
        "$value": ["Geist Mono", "monospace"],
        "$description": "El manual de marca no define monoespaciada — se mantiene Geist Mono (uso interno: código, IDs, JSON), nunca visible como tipografía de marca."
      }
    },
    "fontSize": {
      "xs": { "$type": "dimension", "$value": "0.75rem" },
      "sm": { "$type": "dimension", "$value": "0.875rem" },
      "base": { "$type": "dimension", "$value": "1rem" },
      "lg": { "$type": "dimension", "$value": "1.125rem" },
      "xl": { "$type": "dimension", "$value": "1.25rem" },
      "2xl": { "$type": "dimension", "$value": "1.5rem" },
      "3xl": { "$type": "dimension", "$value": "1.875rem" },
      "4xl": { "$type": "dimension", "$value": "2.25rem" }
    }
  },
  "radius": {
    "base": { "$type": "dimension", "$value": "0.625rem" }
  },
  "content": {
    "$description": "Branding centralizado (nombre + assets). NO pasa por `pnpm tokens:build` (es texto/rutas, no CSS) — se consume directo vía `src/design-system/tokens/brand.ts`, que importa este JSON. Rebrandear la app real igual requiere reemplazar los binarios de `public/brand/*.png` y `src/app/favicon.ico` — ver `BRANDING.md`.",
    "appName": { "$type": "content", "$value": "TekoApp" },
    "logoPath": { "$type": "content", "$value": "/brand/logo.png" },
    "bannerPath": { "$type": "content", "$value": "/brand/banner.png" }
  },
  "theme": {
    "$description": "Mapeo semántico claro/oscuro — nombres alineados 1:1 con las variables CSS que shadcn/ui espera (--background, --primary, etc). Nunca se referencian colores crudos en componentes, siempre estos nombres semánticos.",
    "light": {
      "background": { "$type": "color", "$value": "{color.brand.neutral.0}" },
      "foreground": { "$type": "color", "$value": "{color.brand.neutral.900}" },
      "card": { "$type": "color", "$value": "{color.brand.neutral.0}" },
      "card-foreground": {
        "$type": "color",
        "$value": "{color.brand.neutral.900}"
      },
      "popover": { "$type": "color", "$value": "{color.brand.neutral.0}" },
      "popover-foreground": {
        "$type": "color",
        "$value": "{color.brand.neutral.900}"
      },
      "primary": {
        "$type": "color",
        "$value": "{color.brand.primary.600}",
        "$description": "Usa el shade 600 (accesible), no el 500 exacto de marca — ver descripción en color.brand.primary.600."
      },
      "primary-foreground": {
        "$type": "color",
        "$value": "{color.brand.neutral.0}"
      },
      "secondary": { "$type": "color", "$value": "{color.brand.neutral.100}" },
      "secondary-foreground": {
        "$type": "color",
        "$value": "{color.brand.neutral.900}"
      },
      "muted": { "$type": "color", "$value": "{color.brand.neutral.100}" },
      "muted-foreground": {
        "$type": "color",
        "$value": "{color.brand.neutral.500}"
      },
      "accent": { "$type": "color", "$value": "{color.brand.accent.500}" },
      "accent-foreground": {
        "$type": "color",
        "$value": "{color.brand.neutral.900}",
        "$description": "Texto oscuro (navy), no blanco — el teal de marca (500) es demasiado claro (L .726) para que texto blanco pase AA (2.3:1); texto oscuro da 7.5:1."
      },
      "destructive": { "$type": "color", "$value": "{color.semantic.danger}" },
      "success": { "$type": "color", "$value": "{color.semantic.success}" },
      "warning": { "$type": "color", "$value": "{color.semantic.warning}" },
      "info": { "$type": "color", "$value": "{color.semantic.info}" },
      "border": { "$type": "color", "$value": "{color.brand.neutral.200}" },
      "input": { "$type": "color", "$value": "{color.brand.neutral.200}" },
      "ring": {
        "$type": "color",
        "$value": "{color.brand.primary.600}",
        "$description": "Usa el mismo shade 600 que --primary (no un shade más claro como antes) — el verde de marca necesita un tono más oscuro que el indigo original para pasar el mínimo de contraste ≥3:1 de componentes UI a la misma claridad relativa."
      },
      "sidebar": { "$type": "color", "$value": "{color.brand.neutral.50}" },
      "sidebar-foreground": {
        "$type": "color",
        "$value": "{color.brand.neutral.900}"
      },
      "sidebar-primary": {
