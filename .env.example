# Copiar a .env.local para desarrollo. NUNCA committear .env/.env.local reales.
# Todas estas variables son server-only (no tienen prefijo NEXT_PUBLIC_) salvo que se indique
# lo contrario — el browser JAMÁS debe ver la URL real del backend, el secret de Basic Auth,
# ni la clave pública RSA. Ver documentation/architecture.md → "El diseño clave: la capa BFF".

# URL real del backend NestJS (server-only, usada por app/api/backend/[...path]/route.ts)
BACKEND_API_URL=http://localhost:3000/tekoapp-backend/api

# Credenciales de cliente (Basic Auth) para este frontend — ver ApiClientCredential en el backend.
# Coordinar con TekoApp-Backend: prisma/seed.ts crea un cliente "web" para desarrollo local.
BACKEND_CLIENT_ID=tekoapp-web
BACKEND_CLIENT_SECRET=

# Clave pública RSA del backend (JWT_PUBLIC_KEY), para cifrar el password antes de /auth/login.
# Formato PEM con \n escapados en una sola línea, ej: "-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----"
BACKEND_JWT_PUBLIC_KEY=

# Namespace de WebSocket del backend (LocationsGateway) — usado solo por app/api/realtime/ticket
BACKEND_SOCKET_URL=http://localhost:3000

# URL pública de este frontend (para el LocationsGateway CORS del backend — variable FRONTEND_URL allá)
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Google Maps (mismo proveedor que usa el backend) — clave con restricción de referrer en producción
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
